[Unit]
Description=Nimbus robot controller (Neato serial transport, REST on :8080)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@HOME@/projects/nimbus
Environment=NIMBUS_NEATO_PORT=/dev/ttyACM0
ExecStart=@HOME@/projects/nimbus-env/bin/nimbus run --transport neato
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
